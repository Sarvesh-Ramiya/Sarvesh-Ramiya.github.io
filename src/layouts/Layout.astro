---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	/** Optional class on `<body>` (e.g. page-specific background). */
	bodyClass?: string;
}

const { title = 'Portfolio', bodyClass } = Astro.props;
const bodyStyle =
	bodyClass === 'page-theme-github'
		? 'background-color: #010409; color: #e6edf3;'
		: 'background-color: #131314; color: #e8eaed;';
---

<!doctype html>
<html lang="en" class="theme-gemini-dark" style="background-color: #131314;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#131314" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class:list={[bodyClass]} style={bodyStyle}>
		<SiteHeader />
		<slot />
	</body>
</html>
