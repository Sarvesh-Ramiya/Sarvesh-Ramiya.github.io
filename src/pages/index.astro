---
import Layout from '../layouts/Layout.astro';
import OrganizationsSection from '../components/OrganizationsSection.astro';
import { homeBio } from '../data/homePage';

const name = 'Sarvesh Ramiya';
---

<Layout title={`${name} — Portfolio`}>
	<main class="page">
		<section id="home" class="hero" aria-label="Introduction">
			<h1 class="name">{name}</h1>
			<p class="bio">
				{
					homeBio.split('\n\n').map((para, idx, arr) => (
						<>
							{idx > 0 && (
								<>
									<br />
									<br />
								</>
							)}
							{para}
						</>
					))
				}
			</p>
			<div class="social-links" aria-label="Social links">
				<a
					class="social-link"
					href="https://github.com/rksarvesh"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
				>
					<svg class="social-icon" viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.35.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
						/>
					</svg>
					<span class="sr-only">GitHub</span>
				</a>
				<a
					class="social-link"
					href="https://www.linkedin.com/in/rksarvesh/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
				>
					<svg class="social-icon" viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M3.5 1.5A1.5 1.5 0 1 1 0.5 1.5a1.5 1.5 0 0 1 3 0ZM0.75 4.5h2.5V16H0.75V4.5ZM5.25 4.5h2.4v1.6h.03c.33-.62 1.13-1.27 2.32-1.27 2.48 0 2.94 1.63 2.94 3.74V16h-2.5v-6.55c0-1.56-.03-2.83-1.69-2.83-1.7 0-1.96 1.3-1.96 2.74V16h-2.5V4.5Z"
						/>
					</svg>
					<span class="sr-only">LinkedIn</span>
				</a>
				<a
					class="social-link"
					href="mailto:rksarvesh@gmail.com"
					aria-label="Gmail"
				>
					<svg class="social-icon" viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M0 3.5A2.5 2.5 0 0 1 2.5 1h11A2.5 2.5 0 0 1 16 3.5v9A2.5 2.5 0 0 1 13.5 15h-11A2.5 2.5 0 0 1 0 12.5v-9Zm2.22.61c-.4.22-.66.65-.66 1.11v.1l5.63 4.02a1.5 1.5 0 0 0 1.74 0l5.63-4.02v-.1c0-.46-.26-.89-.66-1.11L10.19 4.8a1.5 1.5 0 0 1-1.74 0L2.22 4.11Z"
						/>
						<path
							fill="currentColor"
							d="M1.5 6.5V12.5c0 .55.45 1 1 1h11c.55 0 1-.45 1-1V6.5l-4.92 3.52a3 3 0 0 1-3.16 0L1.5 6.5Z"
						/>
					</svg>
					<span class="sr-only">Gmail</span>
				</a>
			</div>
		</section>

		<div id="education" class="home-education">
			<OrganizationsSection />
		</div>
	</main>
</Layout>

<style>
	.page {
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		background-color: #131314;
		background-color: var(--color-bg, #131314);
	}

	.home-education {
		scroll-margin-top: 4.5rem;
		flex: 1 1 50%;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	.home-education :global(.orgs) {
		flex: 1 1 auto;
		min-height: 0;
	}

	.hero {
		scroll-margin-top: 4.5rem;
		flex: 1 1 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: clamp(1.5rem, 5vw, 3rem) clamp(1.25rem, 4vw, 2rem);
		box-sizing: border-box;
	}

	.name {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 6vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.15;
		max-width: 20ch;
		color: var(--color-text);
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.name {
			background: linear-gradient(
				115deg,
				#f1f3f4 0%,
				#b8c9ff 38%,
				#d7c4ff 72%,
				#e8eaed 100%
			);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}
	}

	.bio {
		margin: 0;
		max-width: 36rem;
		font-size: clamp(0.9375rem, 2vw, 1.0625rem);
		line-height: 1.55;
		color: var(--color-muted);
	}

	.social-links {
		margin-top: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
		background: rgba(255, 255, 255, 0.03);
		color: var(--color-accent, #8ab4f8);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
	}

	.social-link:hover {
		border-color: var(--color-border-accent, rgba(138, 180, 248, 0.22));
		background: rgba(255, 255, 255, 0.06);
		color: var(--color-text, #e8eaed);
	}

	.social-link:focus-visible {
		outline: 2px solid var(--color-accent, #8ab4f8);
		outline-offset: 2px;
	}

	.social-icon {
		width: 1.05rem;
		height: 1.05rem;
		display: block;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
